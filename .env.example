# Node FW - exemplo de ambiente
# Copie para .env e ajuste. Nunca versione o .env real.

NODE_ENV=development
SERVICE_NAME=node-fw
LOG_LEVEL=info

# Se true, registra cada evento aceito/rejeitado no log de diagnostico.
# Mantenha false em producao para evitar volume e exposicao de dados.
LOG_EVENTS=false

# API administrativa. Mantenha em loopback; exponha apenas via proxy/TLS.
API_HOST=127.0.0.1
API_PORT=8088
API_BODY_LIMIT_BYTES=1048576

# Coletor Syslog UDP. Deve permanecer em loopback.
UDP_HOST=127.0.0.1
UDP_PORT=5514
UDP_MAX_MESSAGE_BYTES=8192
UDP_RECV_BUFFER_BYTES=1048576
SYSLOG_TAG=nodefw

# Limite de armazenamento do User-Agent por evento.
USER_AGENT_MAX_LENGTH=512

# Redis. Use DB e prefixo exclusivos do Node FW.
# Nunca versione um REDIS_URL com senha.
REDIS_URL=redis://127.0.0.1:6379
REDIS_DB=7
REDIS_PREFIX=nodfw:v1
REDIS_CONNECT_TIMEOUT_MS=2000
REDIS_WRITE_TIMEOUT_MS=2000
REDIS_RECONNECT_MAX_DELAY_MS=5000
REDIS_FLUSH_INTERVAL_MS=100
REDIS_BATCH_SIZE=200
REDIS_QUEUE_MAX_SIZE=10000
REDIS_EVENT_STREAM_ENABLED=true
REDIS_EVENT_STREAM_MAXLEN=50000

# MaxMind GeoLite2 (Country + ASN).
# Credenciais sao secretas; use placeholders reais apenas no .env local/cofre.
# O servico inicia em modo degradado se os bancos nao existirem.
MAXMIND_ENABLED=true
MAXMIND_DB_DIR=./data/geolite2

MAXMIND_ACCOUNT_ID=
MAXMIND_LICENSE_KEY=

MAXMIND_REFRESH_MAX_AGE_DAYS=3
MAXMIND_DOWNLOAD_TIMEOUT_MS=120000
MAXMIND_DOWNLOAD_RETRIES=3
MAXMIND_RETRY_BACKOFF_MS=500
MAXMIND_CACHE_MAX_ENTRIES=10000
MAXMIND_CACHE_TTL_MS=300000
MAXMIND_LOCK_STALE_MS=900000

# Classificacao. O arquivo e opcional; sem ele, os defaults seguros sao usados.
# Copie config/classification.example.json para config/classification.json.
CLASSIFICATION_CONFIG_PATH=./config/classification.json

# Tempo maximo para encerramento gracioso.
SHUTDOWN_TIMEOUT_MS=10000
